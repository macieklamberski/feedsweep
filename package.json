{
  "name": "feedsweep",
  "description": "Tidy up the HTML content in web feeds. Fix feed-specific quirks so content displays in its best possible form.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedsweep.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/feedsweep/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "atom",
    "feed",
    "html",
    "transform",
    "content",
    "sanitize"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.mts",
      "default": "./dist/defaults.mjs"
    },
    "./linkedom": {
      "types": "./dist/parsers/linkedom.d.mts",
      "default": "./dist/parsers/linkedom.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts src/defaults.ts src/parsers/linkedom.ts --format esm --dts --clean --unbundle",
    "test": "bun test",
    "test:linkedom": "DOM_LIBRARY=linkedom bun test",
    "test:jsdom": "DOM_LIBRARY=jsdom bun test"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "gemoji": "^8.1.0",
    "highlight.js": "^11.12.0",
    "html-tag-names": "^2.1.0",
    "linkifyjs": "^4.3.3",
    "mathml-tag-names": "^4.0.0",
    "srcset": "^5.0.3",
    "svg-tag-names": "^3.0.1"
  },
  "peerDependencies": {
    "linkedom": "^0.18.12"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.2",
    "kvalita": "^1.24.3",
    "linkedom": "^0.18.13",
    "trousse": "^2.7.0",
    "tsdown": "^0.23.0"
  }
}
